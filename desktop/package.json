{
  "name": "lucid-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Lucid public EEG analyzer desktop application",
  "main": "main.js",
  "author": "bxane-dev",
  "license": "MIT",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.bxane.lucid",
    "productName": "Lucid",
    "asar": true,
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/lucid-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lucid-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lucid",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science",
      "artifactName": "Lucid-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bxane-dev",
        "repo": "lucid"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
